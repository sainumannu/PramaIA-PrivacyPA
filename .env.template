# Nome dell'applicativo (usato nel logging, nei titoli UI)
APP_NAME=PrivacyManager
APP_ID=PramaIA-PrivacyManager

# ============================================
# CONFIGURAZIONE TRAMITE SETUP WIZARD
# ============================================
# Al primo avvio, l'app mostrerà un wizard guidato che configurerà automaticamente:
# - PRAMAIA_JWT_SECRET (sincronizzato con Portal)
# - APP_CLIENT_SECRET (generato automaticamente)
# - PORTAL_URL e PORTAL_API_URL
#
# Puoi anche configurare manualmente copiando questo file in .env e compilando i campi.
# ============================================

# JWT Secret condiviso con Portal (configurato dal wizard)
PRAMAIA_JWT_SECRET=

# Service-to-Service Authentication per License Sync (generato dal wizard)
APP_CLIENT_SECRET=

# URL del Portal (per redirect login) - default: http://localhost:3080
PORTAL_URL=

# Portal API URL (per chiamate backend-to-backend) - default: http://localhost:8080
PORTAL_API_URL=

# Porte
BACKEND_PORT=7003
FRONTEND_PORT=3003

# Logging
# Livello di log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./PramaIA-PrivacyManager.db

# Deployment
DEPLOYMENT_TYPE=on_prem

# Sicurezza API
# Swagger UI / OpenAPI: chiusi di default, abilitare solo in ambienti non pubblici (sviluppo).
ENABLE_API_DOCS=false
# Rate limiting per client (finestra 60 s, in memoria). Dietro reverse proxy impostare TRUST_PROXY=true
# solo se il proxy sovrascrive X-Forwarded-For.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SETUP_PER_MINUTE=20
TRUST_PROXY=false

# Scansione antimalware dei documenti caricati.
#   clamav   -> demone clamd raggiungibile a CLAMAV_HOST:CLAMAV_PORT
#   disabled -> SOLO sviluppo/demo: i file risultano CLEAN senza scansione
#   (vuoto)  -> nessuno scanner: i file restano in QUARANTINED e non sono scaricabili
DOCUMENT_SCAN_MODE=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Import del Registro: ore di validità di un file caricato prima che il job scada (il file viene poi rimosso).
IMPORT_JOB_TTL_HOURS=24

# Autenticazione OpenID Connect (opzionale, in aggiunta al Portal): token firmati dall'IdP dell'ente.
# Validati solo con chiavi asimmetriche; l'ente di appartenenza si legge da un claim del token.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Vuoto = discovery su OIDC_ISSUER/.well-known/openid-configuration
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
# Solo per installazioni a ente unico: tenant usato se il token non ha il claim
OIDC_DEFAULT_TENANT=
OIDC_ROLES_CLAIM=roles
# Ruoli del token (separati da virgola) da trattare come amministratore dell'ente
OIDC_ADMIN_ROLES=

# Migrazioni: "alembic" usa Alembic all'avvio (baseline + revisioni); vuoto = ponte create_all/add_missing_columns
MIGRATIONS=

# Mind integration (opzionale)
MIND_URL=http://localhost:8100
USE_MIND_INTEGRATION=false

# ============================================
# NOTE:
# ============================================
# Se configuri manualmente questo file:
# 1. Copia questo file in .env
# 2. Compila tutti i campi obbligatori
# 3. Riavvia l'applicativo
# 4. Esegui 'python register_to_portal.py' per registrare l'app
#
# Se usi il Setup Wizard (consigliato):
# 1. Avvia l'applicativo
# 2. Segui il wizard guidato
# 3. Il file .env verrà creato automaticamente
# ============================================
